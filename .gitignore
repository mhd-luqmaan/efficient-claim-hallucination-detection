models/*.bin
models/*.pt
models/*.onnx
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/train/*
!data/train/.gitkeep
data/test/*
!data/test/.gitkeep

# Results / logs
*.log
